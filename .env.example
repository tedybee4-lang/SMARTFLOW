# ---- Supabase (public-safe only in NEXT_PUBLIC_) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-publishable-key-here

# ---- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ----
# Set these in Supabase dashboard / Vercel env vars, and .env.local locally. Never commit.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
DATABASE_URL=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SMARTFLOW
TIMEZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES

# ---- PayHero (server-only) ----
# Platform subscription channel (Platform Super Admin configures in dashboard; env holds API creds)
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
# Optional: precomputed "Basic …" header value — used verbatim instead of username/password
PAYHERO_BASIC_TOKEN=
PAYHERO_ACCOUNT_ID=
# Optional override of the default base (https://backend.payhero.co.ke/api/v2)
PAYHERO_BASE_URL=
# Channel used for platform subscription + SMS credit package purchases
PAYHERO_PLATFORM_CHANNEL_ID=
# Optional dedicated channel for SMS purchases (falls back to PAYHERO_PLATFORM_CHANNEL_ID)
PAYHERO_SMS_CHANNEL_ID=
PAYHERO_CALLBACK_TOKEN=
# Public callback base (defaults to NEXT_PUBLIC_APP_URL)
PAYHERO_CALLBACK_URL=

# ---- TOPSPEED SMS (server-only, central shared integration) ----
# Base defaults to https://sms.ispledger.com/api/v3 — override only if told.
TOPSPEED_API_URL=https://sms.ispledger.com/api/v3
TOPSPEED_API_KEY=
TOPSPEED_SENDER_ID=SMARTFLOW

# ---- WhatsApp Cloud API (server-only) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
